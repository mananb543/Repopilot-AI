# ==========================================
# RepoPilot AI - Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server configuration
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# Code Intelligence Service (FastAPI)
CODE_INTELLIGENCE_URL="http://127.0.0.1:8000"

# Client API Base URL (empty for same-origin relative requests)
VITE_API_BASE_URL=""

# Optional Model Providers (Server-side only)
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."

# Persistence & Queues (Phase 2 & Phase 3)
# DATABASE_URL="postgresql://repopilot:repopilot_secret@localhost:5432/repopilot"
# REDIS_URL="redis://localhost:6379"

# GitHub Token for private repository access (Optional)
# GITHUB_TOKEN=""

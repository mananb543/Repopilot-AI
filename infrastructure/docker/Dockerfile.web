FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json vite.config.ts index.html ./
COPY packages/ ./packages/
COPY src/ ./src/

RUN npm install
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
